{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#cba6f7",
      "output": "#cdd6f4",
      "title": "#fab387"
    },
    "percent": {
      "color": {
        "green": "#a6e3a1",
        "yellow": "#f9e2af",
        "red": "#f38ba8"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;147;153;178m┌─\u001b[38;2;137;180;250m Software Information \u001b[38;2;147;153;178m────────────────┐\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;203;166;247m󰣇\u001b[0m",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;203;166;247m\u001b[0m",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;249;226;175m󰏖\u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;166;227;161m\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;250;179;135m󰞷\u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;243;139;168m󰞷\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;147;153;178m├─\u001b[38;2;137;180;250m Hardware Information \u001b[38;2;147;153;178m────────────────┤\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;137;180;250m󰍛\u001b[0m",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;166;227;161m󰢮\u001b[0m",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;249;226;175m󰑭\u001b[0m"
    },
    {
      "type": "disk",
      "showExternal": "false",
      "showSubvolumes": "false",
      "showReadOnly": "false",
      "key": "\u001b[38;2;147;153;178m│\u001b[0m \u001b[38;2;249;226;175m \u001b[0m",
      "hideFS": "NTFS, vfat",
      "format": "{mount-from} {size-used} / {size-total}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;147;153;178m└─────────────────────────────────────────┘\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "      \u001b[38;2;243;139;168m \u001b[38;2;250;179;135m \u001b[38;2;249;226;175m \u001b[38;2;166;227;161m \u001b[38;2;137;180;250m \u001b[38;2;203;166;247m \u001b[38;2;245;194;231m \u001b[38;2;147;153;178m\u001b[0m"
    },
    "break"
  ],
  "logo": {
    "source": "/home/noti/Downloads/images/andou.png",
    "type": "kitty",
    "width": 35,
    "height": 18,
    "padding": {
      "top": 1,
      "left": 1
    },
    "color": {
      "1": "#cba6f7",
      "2": "#fab387"
    }
  }
